# ============================================================
# AarogyaSathi backend configuration (DEVELOPMENT template)
# Copy this file to server/.env and adjust values locally.
# NEVER commit server/.env — it may contain real secrets.
# All values below are placeholders/safe defaults.
# ============================================================

# HTTP host/port the backend listens on.
# 0.0.0.0 binds all interfaces (development); Vite proxies /api to this backend.
HOST=0.0.0.0
PORT=8790

# Local JSON database file (dev only, auto-created).
# The real DB file is git-ignored.
DB_FILE=/abs/path/to/arogyaroot/server/data/db.json

# OTP lifetime and brute-force protection.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_WINDOW_MINUTES=15

# DEVELOPMENT mock OTP mode (NO paid SMS service connected).
# OTP_DEV_MODE=true: the generated OTP is returned in the API response
# and printed in the terminal so login works without an SMS gateway.
# OTP_DEV_CODE: optional FIXED 6-digit OTP for tests (e.g. 123456).
# In production set OTP_DEV_MODE=false and connect a real SMS provider.
OTP_DEV_MODE=true
OTP_DEV_CODE=

# Session (cookie) lifetime.
SESSION_TTL_DAYS=30
SESSION_COOKIE=aarogya_session

# Set COOKIE_SECURE=true only when serving over HTTPS (production).
COOKIE_SECURE=false

# CORS origins allowed to call the API (comma separated).
# In development the Vite dev server proxies /api to this backend,
# so the browser sees a same-origin request and CORS is not needed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173